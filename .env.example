# Copy this file to .env and adjust the values.

# Translation provider:
#   google_free - public Google Translate endpoint, no API key needed (default)
#   google      - Google Cloud Translation API v2, needs TRANSLATION_API_KEY
#   mock        - offline fake translations ("[ta] text"), for tests and demos
TRANSLATION_PROVIDER=google_free
TRANSLATION_API_KEY=
GOOGLE_TRANSLATE_API_ENDPOINT=https://translation.googleapis.com/language/translate/v2
TRANSLATION_TIMEOUT=30

# File handling
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=.xlsx
# UPLOAD_DIR=uploads
# OUTPUT_DIR=outputs

# API / UI
APP_NAME=SOP Translation System
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Used by the Streamlit frontend
API_BASE_URL=http://localhost:8000
